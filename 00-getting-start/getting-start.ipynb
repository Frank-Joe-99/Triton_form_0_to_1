   "source": [
    "# Installation by uv\n",
    "\n",
    "```shell\n",
    "uv venv triton\n",
    "# 进入当前环境\n",
    "source ./triton/bin/activate\n",
    "\n",
    "uv pip install triton\n",
    "```"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4043277a",
   "metadata": {},
   "source": [
    "```shell\n",
    "uv pip install torch torchvision\n",
    "uv pip install matplotlib ipykernel\n",
    "```"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cbc69c99",
   "metadata": {},
   "source": [
    "```shell\n",
    "#退出当前环境\n",
    "deactivate\n",
    "```"
   ]
  }
